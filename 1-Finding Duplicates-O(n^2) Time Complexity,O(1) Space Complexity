#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[100];
    
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
        
    }
    int repeated=0;
    for(int i=0;i<n-1;i++){
        for(int j=i+1;j<n;j++){
            if(arr[i]==arr[j]){
                repeated=arr[i];
            }
        }
    }
    printf("%d",repeated);
}
