#include <stdio.h>

int countZeros(int arr[], int low, int high) {

    
    if(low == high) {
        if(arr[low] == 0)
            return 1;
        else
            return 0;
    }

    
    int mid = (low + high) / 2;

    
    int left = countZeros(arr, low, mid);
    int right = countZeros(arr, mid + 1, high);


    return left + right;
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];

    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int count = countZeros(arr, 0, n - 1);

    printf("%d", count);

    return 0;
}

