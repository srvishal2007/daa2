#include<stdio.h>
int max(int arr[],int high,int low,int maxnum){
    if(low==high){
        if(arr[low]>maxnum){
            maxnum=arr[low];
            return maxnum;
            
        }
        else{
            return maxnum;
        }
    }
        int mid=(high+low)/2;
        int left = max(arr, mid, low,maxnum);
        int right = max(arr,high,mid+1,maxnum);
        if(left>right){
            return left;
        }
        else{
            return right;
        }
    

    
}
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            if(arr[i]>arr[j]){
                int temp=arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
            }
}
}
 int maxnum=0;
    
    int result= max(arr,n-1,0,maxnum);
    printf("%d",result);
}
