#include<stdio.h>
#include<string.h>
int main(){
    char str[100],str1[100];
    scanf("%s",str);
    scanf("%s",str1);
    int cnt=0;
    for(int i=0;i<strlen(str1);i++){
        if(str[i]==str1[i]){
            cnt++;
        }
    }
    printf("%d",cnt);
}
