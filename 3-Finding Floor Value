#include<stdio.h>
int max(int high,int low,int arr[],int x,int ans){
    if(low>high){
        return ans;
    }
    
    int mid=(high+low)/2;
    if(arr[mid]==x){
        return x;
    }
    else if(arr[mid]<x){
        ans=arr[mid];
        return max(high,mid+1,arr,x,ans);
    }
    else{
        return max(mid-1,low,arr,x,ans);
    }
    
    
}

int main(){
    int n;scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int maxnum;
    scanf("%d",&maxnum);
    int ans=-1;
    int result=max(n-1,0,arr,maxnum,ans);
    printf("%d",result);
    
}

