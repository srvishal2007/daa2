#include <stdio.h>

int binarySearch(int arr[], int low, int high, int target)
{
    if (low > high)
        return -1;

    int mid = (low + high) / 2;

    if (arr[mid] == target)
        return mid;

    if (arr[mid] < target)
        return binarySearch(arr, mid + 1, high, target);

    return binarySearch(arr, low, mid - 1, target);
}

int findPair(int arr[], int n, int x, int index)
{
    
    if (index >= n)
        return 0;

    int required = x - arr[index];

    int pos = binarySearch(arr, 0, n - 1, required);

    if (pos != -1 && pos != index)
    {
        printf("%d\n", arr[index]);
        printf("%d\n", arr[pos]);
        return 1;
    }


    return findPair(arr, n, x, index + 1);
}

int main()
{
    int n, x;
    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &x);

    if (!findPair(arr, n, x, 0))
    {
        printf("No\n");
    }

    return 0;
}
