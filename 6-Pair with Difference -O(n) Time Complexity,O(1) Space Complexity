#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    int k;
    scanf("%d", &k);

    int i = 0;
    int j = 1;

    while (i < n && j < n) {

        int diff = a[j] - a[i];

        if (diff == k && i != j) {
            printf("1");
            return 0;
        }
        else if (diff < k) {
            j++;
        }
        else {
            i++;
        }

        if (i == j) {
            j++;
        }
    }

    printf("0");

    return 0;
}
