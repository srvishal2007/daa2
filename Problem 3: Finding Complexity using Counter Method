#include<stdio.h>
void Factor( int num) 
 {
     int count=1;
     
    for (int i = 1; i <= num;++i)
    {
        count+=2;
     if (num % i== 0)
        {
            count++;
          
        }        
     } 
     printf("%d",count);
  }
  
